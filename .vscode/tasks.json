{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Next.js dev server (port 3002)",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev",
				"--",
				"--hostname",
				"0.0.0.0",
				"--port",
				"3002"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "nextjs",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*Starting\\.\\.\\.$",
					"endsPattern": "^.*Ready in .*$"
				}
			},
			"group": "build"
		},
		{
			"label": "MESM Development Server (3000)",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev",
				"--",
				"--hostname",
				"127.0.0.1",
				"--port",
				"3000"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "nextjs",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*Starting\\.\\.\\.$",
					"endsPattern": "^.*Ready in .*$"
				}
			},
			"group": "build"
		}
	]
}