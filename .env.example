# ============================================================================
# MEEMS GEMS ENVIRONMENT CONFIGURATION
# ============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=https://meemsgems.com

# Admin Authentication
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Supabase PostgreSQL Database (Optional - runs in local persistence mode if empty)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
